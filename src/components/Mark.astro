---
import { UPPER, LOWER, WIDTH, HEIGHT, toPath } from '../mark';
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg class={className} width={size} height={(size * HEIGHT) / WIDTH} viewBox={`-0.05 -0.05 ${WIDTH + 0.1} ${HEIGHT + 0.1}`} aria-hidden="true" focusable="false">
  <path d={toPath(UPPER)} fill="currentColor" />
  <path d={toPath(LOWER)} fill="currentColor" opacity="0.72" />
</svg>
